+    `_apply_minimum_size` runs after `register_extra_formats`/`install_engine_presets`, and
+    again on the first show, so the tall label below cannot be clipped either.
+    """
+    dialog = ExportDialog(project)
+    dialog.register_format("custom_fmt", "A deliberately long custom export format label (.xyz)",
+                           lambda meta, out_dir: [])
+    _shown_at_minimum(dialog)
+    box = dialog.format_checks["custom_fmt"]
+    assert box.height() >= box.sizeHint().height()
+    assert dialog.options_scroll.viewport().width() >= box.sizeHint().width()
+    _close(dialog)
+
+
+def test_minimum_size_never_exceeds_the_available_screen(qapp, project):
+    """Requirement: the computed minimum is capped, so the dialog always fits on screen."""
+    dialog = _shown_at_minimum(ExportDialog(project))
+    available = QGuiApplication.primaryScreen().availableGeometry()
+    assert dialog.minimumWidth() <= available.width()
+    assert dialog.minimumHeight() <= available.height()
+    _close(dialog)
+
+
+def _wheel_at(widget, delta):
+    """One wheel notch over the centre of `widget`."""
+    centre = widget.rect().center()
+    return QWheelEvent(QPointF(centre), QPointF(widget.mapToGlobal(centre)),
+                       QPoint(0, delta), QPoint(0, delta),
+                       Qt.NoButton, Qt.NoModifier, Qt.NoScrollPhase, False)
+
+
+def test_wheel_over_an_unfocused_spin_box_scrolls_instead_of_editing(qapp, project):
+    """D11 regression: the scrolling options pane turned a stray wheel into an edit.
+
+    `columns` and `extrude` reach the exported sheet layout and `_save_settings`
+    persists them, and the pivot spins go into the Aseprite/Godot metadata, so a
+    wheel over an unfocused editor must not change any of them. The gesture must
+    still reach the pane, so the scroll bar moves instead.
+    """
+    dialog = _shown_at_minimum(ExportDialog(project))
+    bar = dialog.options_scroll.verticalScrollBar()
+    assert bar.maximum() > 0, "the pane must be scrollable for this test to mean anything"
+    editors = [dialog.columns, dialog.extrude, dialog.border, dialog.shape, dialog.inner,
+               dialog.pivot_x_spin, dialog.pivot_y_spin, dialog.engine_preset_box.combo]
+    for editor in editors:
+        assert not editor.hasFocus()
+        reads = (editor.currentIndex if hasattr(editor, "currentIndex") else editor.value)
+        before = reads()
+        bar.setValue(0)
+        QApplication.sendEvent(editor, _wheel_at(editor, -120))
+        QApplication.processEvents()
+        assert reads() == before, f"a wheel changed {editor.objectName() or editor}"
+        assert bar.value() > 0, "the wheel must scroll the options pane"
+    _close(dialog)
+
+
+def test_a_focused_spin_box_keeps_the_wheel(qapp, project):
+    """The guard is about focus, not about disabling the wheel: a user who clicked
+    into the field still scrolls its value."""
+    dialog = _shown_at_minimum(ExportDialog(project))
+    dialog.columns.setFocus(Qt.MouseFocusReason)
+    QApplication.processEvents()
+    assert dialog.columns.hasFocus()
+    before = dialog.columns.value()
+    QApplication.sendEvent(dialog.columns, _wheel_at(dialog.columns, 120))
+    assert dialog.columns.value() == before + 1
+    _close(dialog)
+
+
+def test_every_value_editor_in_the_options_pane_is_wheel_guarded(qapp, project):
+    """Root cause, not one widget: every spin box, combo and slider inside the
+    scrolling pane must carry the guard, including a late one from
+    `install_engine_presets`."""
+    dialog = _shown_at_minimum(ExportDialog(project))
+    found = []
+    for widget_type in ed.WHEEL_GUARDED_TYPES:
+        found.extend(dialog.options_widget.findChildren(widget_type))
+    assert len(found) >= 8
+    for widget in found:
+        assert widget.focusPolicy() == Qt.StrongFocus, widget
+    _close(dialog)
