+def aspect_crop_box(content: Size, cell: Size, anchor: str,
+                    protect: Optional[Rect] = None) -> Rect:
+    """Largest box inside ``content`` with the aspect of ``cell``, placed by ``anchor``.
+
+    A profile that crops to the cell aspect trims a frame to the cell's
+    proportions before it scales it, so the output fills the cell. A
+    proportional fit alone letterboxes: a 1280x720 frame fitted into a
+    256x256 cell becomes 256x144 content between transparent bars. Cropped
+    first, the same frame becomes 720x720 and then scales to a full 256x256.
+
+    The box keeps the edge its anchor keeps in :func:`anchor_offset`:
+    ``bottom_center`` keeps the bottom edge and centers horizontally, so a
+    character's feet stay planted. Content already at the cell aspect returns
+    the full box.
+
+    ``protect`` names a rect the box must contain -- the subject. The crop
+    trims margin, never the subject. The stabilize stage emits the content
+    bbox of a whole action, so a standing character fills the frame top to
+    bottom; cropping that to a square cell would cut the head off. When the
+    subject is too large for the ideal box, the box grows along the
+    constrained axis until it covers the subject, and the scale that follows
+    letterboxes whatever aspect is left. Pass ``None`` for a frame with no
+    transparency, where there is no subject to protect and the crop is free.
+    """
+    w, h = int(content[0]), int(content[1])
+    cw, ch = int(cell[0]), int(cell[1])
+    if w < 1 or h < 1 or cw < 1 or ch < 1:
+        raise ValueError(f"sizes must be positive: content={content} cell={cell}")
+    # Cross-multiplied integers, so an exact-aspect frame never rounds through
+    # a float ratio into a one-pixel-narrower crop.
+    if w * ch > h * cw:            # content is wider than the cell: trim width
+        bw, bh = max(1, min(w, (h * cw) // ch)), h
+    elif w * ch < h * cw:          # content is taller than the cell: trim height
+        bw, bh = w, max(1, min(h, (w * ch) // cw))
+    else:
+        bw, bh = w, h
+    if protect is None:
+        x, y = anchor_offset(anchor, (bw, bh), (w, h))
+        return (x, y, bw, bh)
+    px, py, pw, ph = (int(v) for v in protect)
+    # Grow the box to the subject's size, then slide it so the subject is inside.
+    # The growth uses the subject's width and height, never its far edge: a
+    # subject at x=200 that is 240 wide needs a 240-wide box, not a 440-wide one.
+    bw = min(w, max(bw, pw))
+    bh = min(h, max(bh, ph))
+    x, y = anchor_offset(anchor, (bw, bh), (w, h))
+    x = min(max(x, px + pw - bw), px)
+    y = min(max(y, py + ph - bh), py)
+    x = min(max(x, 0), w - bw)
+    y = min(max(y, 0), h - bh)
+    return (x, y, bw, bh)
