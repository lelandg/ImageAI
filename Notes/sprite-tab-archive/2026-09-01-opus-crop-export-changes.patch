+def test_aspect_crop_box_trims_the_long_axis():
+    # 16:9 into a square cell: the full height survives, the width is trimmed.
+    assert aspect_crop_box((1280, 720), (256, 256), "bottom_center") == (280, 0, 720, 720)
+    # 9:16 into a square cell: the full width survives, the height is trimmed
+    # from the top because bottom_center keeps the bottom edge.
+    assert aspect_crop_box((720, 1280), (256, 256), "bottom_center") == (0, 560, 720, 720)
+    # A square source into a 16:9 cell trims the height instead.
+    assert aspect_crop_box((720, 720), (320, 180), "bottom_center") == (0, 315, 720, 405)
+
+
+def test_aspect_crop_box_is_a_no_op_at_the_cell_aspect():
+    """Content already at the cell aspect keeps every pixel, whatever the anchor."""
+    for anchor in ANCHORS:
+        assert aspect_crop_box((640, 360), (16, 9), anchor) == (0, 0, 640, 360)
+        assert aspect_crop_box((256, 256), (64, 64), anchor) == (0, 0, 256, 256)
+
