+# --- hd fills its cell only when the profile asks (crop to the cell aspect) ---
+
+def _wide_stabilize_frames(directory, count=3, size=(640, 360)):
+    """Opaque 16:9 "stabilized" frames: a red body between blue and green bars.
+
+    hd reads the stabilize output, so these stand in for it directly. The
+    content fills the frame edge to edge, which is what a real stabilized
+    frame looks like after the union-bbox crop.
+    """
+    directory.mkdir(parents=True, exist_ok=True)
+    bar = size[0] // 8
+    paths = []
+    for index in range(count):
+        im = Image.new("RGBA", size, (200, 40, 40, 255))
+        im.paste(Image.new("RGBA", (bar, size[1]), (40, 40, 200, 255)), (0, 0))
+        im.paste(Image.new("RGBA", (bar, size[1]), (40, 200, 40, 255)), (size[0] - bar, 0))
+        path = directory / f"{index + 1:04d}.png"
+        im.save(path, format="PNG")
+        paths.append(path)
+    return paths
+
+
+def _margin_stabilize_frames(directory, count=3, size=(640, 360), subject_w=240):
+    """16:9 frames whose subject sits in transparent margin.
+
+    This is the shape the aspect crop exists for: the margin is transparent,
+    so `subject_bbox` can tell it apart from the character and the crop has
+    something safe to trim.
+    """
+    directory.mkdir(parents=True, exist_ok=True)
+    left = (size[0] - subject_w) // 2
+    paths = []
+    for index in range(count):
+        im = Image.new("RGBA", size, (0, 0, 0, 0))
+        im.paste(Image.new("RGBA", (subject_w, size[1]), (200, 40, 40, 255)), (left, 0))
+        path = directory / f"{index + 1:04d}.png"
+        im.save(path, format="PNG")
+        paths.append(path)
+    return paths
+
+
+def test_hd_runner_crops_the_transparent_margin_to_fill_the_cell(tmp_path):
+    """With crop_to_cell_aspect on, the crop trims margin so the subject grows.
+
+    A 640x360 frame in a 256x256 cell letterboxes to 256x144 of content. The
+    crop takes the transparent margin down to 360x360 first, so the same
+    subject reaches the full 256 rows of the cell. `subject_bbox` protects the
+    character, so only margin is lost.
+    """
+    project, action = _project(tmp_path)
+    assert project.profiles[0].cell_size == (256, 256)
+    assert project.profiles[0].upscale_small is False  # a downscale still fills the cell
+    assert project.profiles[0].crop_to_cell_aspect is True
+    frames = _margin_stabilize_frames(tmp_path / "stab")
+    out = pipeline.hd_runner(project, action, frames, tmp_path / "hd", no_progress, None)
+
+    assert len(out) == 3
+    boxes = []
+    for path in out:
+        with Image.open(path) as im:
+            assert im.size == (256, 256)
+            boxes.append(im.getchannel("A").getbbox())
+    # One crop box for the whole action: the subject does not shift between frames.
+    assert len(set(boxes)) == 1
+    x0, y0, x1, y1 = boxes[0]
+    # The crop reached the cell aspect, so the subject spans every row of the cell.
+    assert (y0, y1) == (0, 256)
+
+    # The same frames without the crop letterbox instead: 640x360 -> 256x144.
+    project.profiles[0].crop_to_cell_aspect = False
+    plain = pipeline.hd_runner(project, action, frames, tmp_path / "hd_plain", no_progress, None)
+    with Image.open(plain[0]) as im:
+        px0, py0, px1, py1 = im.getchannel("A").getbbox()
+    assert (py1 - py0) == 144
+    assert (y1 - y0) > (py1 - py0)      # the crop bought real cell coverage
+    assert (x1 - x0) > (px1 - px0)
+
+
+def test_hd_runner_crop_never_drops_a_column_of_an_opaque_frame(tmp_path):
+    """Default project: the crop keeps every pixel of a frame with no alpha.
+
+    The stabilize stage hands hd the content's own bbox, so an unconstrained
+    crop to a square cell would delete the top of a standing character.
+    `subject_bbox` protects the whole frame when there is no alpha to mark the
+    margin, so the crop trims nothing and the scale letterboxes instead.
