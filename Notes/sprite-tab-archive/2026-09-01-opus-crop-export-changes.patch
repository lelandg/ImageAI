+def _wide_frame(path, size=(160, 90), bar=20):
+    """One opaque 16:9 frame: red body between a blue left bar and a green right bar."""
+    im = Image.new("RGBA", size, (200, 40, 40, 255))
+    im.paste(Image.new("RGBA", (bar, size[1]), (40, 40, 200, 255)), (0, 0))
+    im.paste(Image.new("RGBA", (bar, size[1]), (40, 200, 40, 255)), (size[0] - bar, 0))
+    path.parent.mkdir(parents=True, exist_ok=True)
+    im.save(path, format="PNG")
+    return path
+
+
+def test_aspect_crop_gain_returns_none_when_the_crop_cannot_fill_the_cell():
+    """D2/D7/D10 regression: the crop only earns its loss when the scale can then fill.
+
+    With upscale off, a crop that lands below the cell size buys nothing:
+    fit_size caps the scale at 1.0, so the content sits at its native size
+    either way and the crop has only deleted pixels.
+    """
+    # 300x100 -> 100x100 cannot reach a 256x256 cell without an upscale.
+    assert aspect_crop_gain((300, 100), (256, 256), "bottom_center", allow_upscale=False) is None
+    # The same crop is worth it when the scale may enlarge it.
+    assert aspect_crop_gain((300, 100), (256, 256), "bottom_center",
+                            allow_upscale=True) == (100, 0, 100, 100)
+    # A crop that still covers the cell fills it by a downscale alone.
+    assert aspect_crop_gain((1280, 720), (256, 256), "bottom_center",
+                            allow_upscale=False) == (280, 0, 720, 720)
+    # Content already at the cell aspect has nothing to gain either.
+    assert aspect_crop_gain((640, 360), (16, 9), "center", allow_upscale=True) is None
+
