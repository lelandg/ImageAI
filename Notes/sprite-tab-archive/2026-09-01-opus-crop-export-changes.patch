+def test_sheet_meta_warns_once_per_action_when_the_profile_stage_is_missing(tmp_path, caplog):
+    """The fallback is invisible in the export, so it must be visible in the log.
+
+    D4 regression: one warning per *action*, never one per call. A call with
+    one good action and two broken ones told the user about one of the two,
+    and the export silently mixed cell-size frames with raw stabilize frames.
+    One line per frame is equally wrong: a 24-frame action would write 24.
+    """
+    project = _build(tmp_path / "sprites" / "P_1")
+    stabilize = project.project_dir / "stages" / "a1" / "stabilize"
+    project.actions[0].frames += [
+        FrameMeta(name=f"walk_{i:02d}", source_path=_write(stabilize / f"{i:04d}.png"),
+                  frame=(0, 0, 32, 32), source_size=(32, 32))
+        for i in (2, 3, 4)
+    ]
+    for action_id, name in (("a2", "jump"), ("a3", "idle")):
+        card = ActionCard(id=action_id, name=name, prompt=name)
+        card.frames = [FrameMeta(name=f"{name}_00",
+                                 source_path=_write(project.project_dir / "stages" / action_id /
+                                                    "stabilize" / "0001.png"),
+                                 frame=(0, 0, 32, 32), source_size=(32, 32))]
+        project.actions.append(card)
+
+    with caplog.at_level(logging.WARNING, logger="core.sprite.project"):
+        meta = project.sheet_meta("pixel")
+
+    warnings = [r.getMessage() for r in caplog.records if r.levelno == logging.WARNING]
+    assert len(warnings) == 3                      # one per broken action, not one per call
+    assert [name for name in ("walk", "jump", "idle")
+            if any(f"action '{name}'" in text for text in warnings)] == ["walk", "jump", "idle"]
+    assert str(project.project_dir / "stages" / "a1" / "pixel") in warnings[0]
+    # The fallback itself is unchanged: every frame still points at stabilize.
+    assert [f.source_path.parent.name for f in meta.frames] == ["stabilize"] * 6
+
+
